{
	"nodes":[
		{"id":"7dfe2400f84028b0","type":"file","file":"Сатис/Культ Клеоноса.md","x":-280,"y":-60,"width":400,"height":320},
		{"id":"f81b9344629733fc","type":"text","text":"Культисты отправились на север Арда в поисках Корина. Они не знают его имени, только внешность.\n\nПопутно устраивают показательные убийства служителей и нападают на штабы и базилики","x":247,"y":-520,"width":250,"height":260,"color":"1"},
		{"id":"034c0394b8f3d37f","type":"file","file":"Сатис/Клеонос.md","x":-279,"y":-820,"width":400,"height":356},
		{"id":"f621b26e89d934b2","type":"text","text":"Клеонос показал видение ведунье (слепые, обладающие магией памяти предков), в котором был облик Корина","x":260,"y":-160,"width":297,"height":130,"color":"1"},
		{"id":"c7438fad371f1f53","type":"text","text":"\"Шрам\" из народа пустынь","x":415,"y":203,"width":265,"height":60},
		{"id":"07bf2e2aa60069f9","type":"text","text":"Корина ранят кинжалом с ядом из корня пустынного растения","x":372,"y":-751,"width":250,"height":109,"color":"1"},
		{"id":"806a84d29007d929","type":"text","text":"он начал понимать язык сфинксов с помощью проснувшейся в нём магии","x":757,"y":-851,"width":250,"height":86,"color":"1"},
		{"id":"7e56564ca401f3d7","type":"text","text":"он должен был умереть, но не умер","x":733,"y":-721,"width":250,"height":79,"color":"1"},
		{"id":"b8377bff17c08dd1","type":"file","file":"Сатис/Корин.md","x":658,"y":-464,"width":400,"height":470}
	],
