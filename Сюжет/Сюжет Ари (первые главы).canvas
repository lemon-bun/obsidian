{
	"nodes":[
		{"id":"9be3f28f5502a8f2","type":"group","x":-4560,"y":-840,"width":3840,"height":1160,"color":"2","label":"старая 1.2 глава"},
		{"id":"49819af7559b0fef","type":"group","x":-3200,"y":-2120,"width":2480,"height":1101,"color":"2","label":"старая 1 глава"},
		{
			"id":"534c3c2e884d7cf6",
			"type":"text",
			"text":"Относительно Корина орден скажет, что они не ставят на него каких либо ставок, но в случае чего советуют обратиьтся к медикам базилики",
			"styleAttributes":{},
			"x":2050,
			"y":-543,
			"width":260,
			"height":185,
			"color":"2"
		},
		{"id":"d5e672a50f892c90","type":"text","text":"1.Культ проник на север, о чём ей расскажут в штабе\n2.Руны явно написаны знающими язык пустыни и сфинксов\n3.капеллан - главный член базилики и прямой представитель богов в народе","x":2546,"y":-422,"width":250,"height":256},
		{
			"id":"1309e6800ed730c8",
			"type":"text",
			"text":"посещение штаба ордена",
			"styleAttributes":{"textAlign":"center"},
			"x":1263,
			"y":-422,
			"width":250,
			"height":60,
			"color":"2"
		},
		{"id":"bb80401768ff8ff0","type":"text","text":"Ари рассказывает о нападении","x":1672,"y":-481,"width":188,"height":60,"color":"2"},
		{"id":"db5d09ba6ec7fd6d","type":"text","text":"Ари вручают письмо от матери о совете","x":1692,"y":-405,"width":208,"height":60,"color":"4"},
		{"id":"4e1ed6d4c7fb32c5","type":"file","file":"Сатис/Арилайа Ноксус.md","x":0,"y":-811,"width":400,"height":782},
		{"id":"9cd76585ed0fb4fb","type":"file","file":"Сатис/Орден Золотых Масок.md","x":-480,"y":-811,"width":400,"height":680},
		{"id":"551d69db4c99f94b","type":"text","text":"Ари рассказывают про культ на севере","x":1680,"y":-314,"width":205,"height":60,"color":"2"},
		{
			"id":"7617f0f3beff7b42",
			"type":"text",
			"text":"**3 глава**\nРасследование убийства Капеллана в Ипреиме",
			"styleAttributes":{"textAlign":"center"},
			"x":564,
			"y":-129,
			"width":400,
			"height":100,
			"color":"6"
		},
		{"id":"d6c5b9082d71eea9","type":"text","text":"Ари задумается, что убийство хоть и походит на ритуальное, но оно не показательное, а это не в духе культа. ==Они бы выставили тело на всеобщее обозрение==\nТак же на карте не было точки рядом с Импреимом","x":3260,"y":-150,"width":320,"height":210},
		{"id":"3706c2c39579c5fc","type":"text","text":"Ари думает на культистов","x":2112,"y":-130,"width":250,"height":50},
		{"id":"eff6eec419b859b3","type":"text","text":"Данакт расскажет про Дельца","x":3660,"y":-106,"width":187,"height":60},
		{"id":"43c927f2ff5a436e","type":"text","text":"написанное будет одним из текстов пророчества о возвращении Клеоноса","x":1760,"y":-151,"width":250,"height":93},
		{
			"id":"0c6f061e423b2d45",
			"type":"text",
			"text":"осмотр тела",
			"styleAttributes":{"textAlign":"center"},
			"x":1472,
			"y":-140,
			"width":166,
			"height":60,
			"color":"6"
		},
		{
			"id":"1745f96d870ba04b",
			"type":"text",
			"text":"базилика",
			"styleAttributes":{"textAlign":"center"},
			"x":1072,
			"y":-59,
			"width":128,
			"height":60,
			"color":"6"
		},
		{"id":"789a733eef678e72","type":"file","file":"Сатис/Культ Клеоноса.md","x":-480,"y":-58,"width":400,"height":718},
		{"id":"f028eb2516e7e5f9","type":"text","text":"Ари захочет найти следы, чтобы выяснить подробности, зачем культ сюда пришёл, потом учто это хоть как-то закроет вопрос нападения","x":-1179,"y":-1989,"width":329,"height":133},
		{"id":"5cf9c44ea34312f2","type":"text","text":"Ари обеспокоится безопасностью разведчиков, если культ научился их вычислять, и информацией, которую культ может перехватить ","x":-1114,"y":-1834,"width":301,"height":122},
		{
			"id":"cc835b5f50a26845",
			"type":"text",
			"text":"Появление Фло",
			"styleAttributes":{"textAlign":"center"},
			"x":2474,
			"y":-70,
			"width":179,
			"height":50,
			"color":"6"
		},
		{"id":"2cb99556cac82073","type":"text","text":"укажет на то, что Ари что-то упускает\nнапомнит, что от исхода этого задания зависит будущее Ари","x":2800,"y":-95,"width":339,"height":99},
		{
			"id":"a89a1417b73c6939",
			"type":"text",
			"text":"по пути оставить загадку для читателя, что происходит",
			"styleAttributes":{},
			"x":1442,
			"y":-3,
			"width":260,
			"height":60
		},
		{
			"id":"d43eb587da9faa7e",
			"type":"text",
			"text":"оставляем допрос Данакта",
			"styleAttributes":{"textAlign":"center"},
			"x":1780,
			"y":-1,
			"width":250,
			"height":56,
			"color":"6"
		},
		{"id":"bd81d87c45e7139f","type":"text","text":"при осмотре Ари найдёт письмо от Дельца с указанием времени (подпись Д)\n\n\"К - тут ничего нет\"\n\"А - тут точно что-то есть\"","x":2176,"y":122,"width":250,"height":193},
		{"id":"197fb83775d5954f","type":"text","text":"Ари убеждается, что Делец как-то замешан и надо бы узнать больше","x":2543,"y":113,"width":250,"height":105},
		{"id":"bdfd83b046c9cc35","type":"text","text":"убираем руну из спальни капеллана","x":1885,"y":130,"width":250,"height":56},
		{
			"id":"ff4e4c5318e6707a",
			"type":"text",
			"text":"Спальня капеллана",
			"styleAttributes":{"textAlign":"center"},
			"x":1472,
			"y":188,
			"width":208,
			"height":60,
			"color":"6"
		},
		{
			"id":"a33a94e40f2b143c",
			"type":"text",
			"text":"находят конверт с деньгами ",
			"styleAttributes":{},
			"x":2080,
			"y":360,
			"width":260,
			"height":60
		},
		{
			"id":"8553ca87a9d15833",
			"type":"text",
			"text":"**мнение Корина**\nЦерковь специально подстроила убийство капеллана, чтобы показать другим служителям, что будет если они нарушат что-либо",
			"styleAttributes":{},
			"x":2500,
			"y":420,
			"width":296,
			"height":152
		},
		{"id":"7eea794e19ae5255","type":"text","text":"диалог между Ари и Корином с его сомнениями в адрес церкви","x":2081,"y":465,"width":336,"height":61},
		{"id":"b66d0ea70e6404c1","type":"text","text":"Делец заодно провёл встречу с капелланом","x":1979,"y":720,"width":250,"height":60},
		{"id":"5bf44a45fb0532a9","type":"text","text":"Шрам перевозит книгу с места на место для безопасности","x":1246,"y":737,"width":250,"height":89},
		{"id":"36900ce7c62defe9","type":"text","text":"заодно убил капелана","x":2344,"y":756,"width":250,"height":60},
		{
			"id":"192dbfa9e8280ba9",
			"type":"text",
			"text":"==КНИГА==",
			"styleAttributes":{"textAlign":"center"},
			"x":1060,
			"y":756,
			"width":124,
			"height":50,
			"color":"3"
		},
		{"id":"787a11007296f71a","type":"text","text":"договорился с Дельцом на перевозку книги в глубь Арда","x":1572,"y":751,"width":312,"height":60},
		{"id":"58d6ace795b36538","type":"text","text":"остался, дожидаясь отправки","x":2007,"y":796,"width":200,"height":60},
		{"id":"204abd8f3a3dd731","type":"text","text":"Ари рассказывает Корину, что Культ в основном ведёт свою деятельность на юге, в нижнем Арде\n\nРаньше они активно устраивали показательные убийства священников и нападали на штабы ордена, но затихли несколько лет назад\nСама Ари участвовала в ряде заданий, где орден преследовал одну из групп культистов. В результате несколько погибли, сама Ари получила несколько шрамов, а глава убил себя в камере до допроса\n\nстранно, что они появились на севере и напали на путников. Ари подозревает, что они могли знать, что герои из ордена, Корин предполагает, что они могли проследить за Ари от связного","x":-1730,"y":-2011,"width":416,"height":407},
		{"id":"bec6c057beba156b","type":"text","text":"Ари посчитает, что это слова о Клеоносе, но её смутит слово \"пророк\"\n\n\"Что-то они явно ищут. Нужно доложить в орден, это могут быть важные сведения\"","x":-1696,"y":-1572,"width":250,"height":223},
		{
			"id":"21b5cb5821236065",
			"type":"text",
			"text":"Ари расскажет про корень и поинтересуется самочувствием Корина.\nПридёт к выводу, что какое-то время за ним понаблюдает, но скорее всего доза была недостаточной",
			"styleAttributes":{},
			"x":-1931,
			"y":-1320,
			"width":360,
			"height":160
		},
		{"id":"b5aabfdc3ea55792","type":"text","text":"пророк, поиск, сила","x":-1996,"y":-1566,"width":216,"height":60},
		{"id":"fb7f7216c640cdac","type":"text","text":"культисты сбегают, оставив их в живых\n==**!! они всегда заканчивают начатое, как и Ари**==","x":-2139,"y":-1732,"width":250,"height":122},
		{"id":"55dbf19564afffd4","type":"text","text":"найдут разведённый порошок из корня","x":-2293,"y":-1410,"width":250,"height":60},
		{"id":"bfec478f5538b5b9","type":"text","text":"не будет сожжённых трав\n","x":-2264,"y":-1493,"width":250,"height":60},
		{"id":"3ecc73f4b68faf53","type":"text","text":"Корин прочитает часть рун из письма в хижине","x":-2347,"y":-1566,"width":250,"height":60},
		{"id":"2d612bdc177f3c2e","type":"text","text":"Корина ранят ядом","x":-2323,"y":-1837,"width":203,"height":60},
		{
			"id":"3bd9de67a309e1a3",
			"type":"text",
			"text":"в хижине",
			"styleAttributes":{"textAlign":"center"},
			"x":-2612,
			"y":-1437,
			"width":116,
			"height":50,
			"color":"6"
		},
		{
			"id":"c6b110d7161c9e33",
			"type":"text",
			"text":"битва с культистами\n([[Культ Клеоноса]])",
			"styleAttributes":{"textAlign":"center"},
			"x":-2669,
			"y":-1774,
			"width":210,
			"height":60,
			"color":"6"
		},
		{
			"id":"91150185b630bda3",
			"type":"text",
			"text":"**1 глава**\nБитва с культистами \nРанение Корина\nОблава на пустой дом\nКорин умеет читать руны",
			"styleAttributes":{"textAlign":"center"},
			"x":-3120,
			"y":-1472,
			"width":250,
			"height":152,
			"color":"6"
		},
		{
			"id":"56af42fbee1b34d0",
			"type":"text",
			"text":"Ари возвращается от связного, тот дал ей следующее задание, такое же мелкое\n\nВ беседе с Корином Ари рассказывает о результатах встречи и решает, что они наконец займутся чем-то важным.\nКак раз дело касается культа, который так далеко не заходил в северную префектуру. И это прекрасная возможность им себя показать.",
			"styleAttributes":{},
			"x":-3496,
			"y":-729,
			"width":400,
			"height":260
		},
		{
			"id":"1c818bf127b74d06",
			"type":"text",
			"text":"Возвращение в таверну",
			"styleAttributes":{"textAlign":"center"},
			"x":-3890,
			"y":-579,
			"width":240,
			"height":60,
			"color":"6"
		},
		{
			"id":"6be292c926f05d07",
			"type":"text",
			"text":"Они находят логово культистов в старой разрушенной эльфийской библиотеке.\nКниг там уже нет, всё разграбили и продали,  что осталось сгнило от сырости и времени",
			"styleAttributes":{},
			"x":-3510,
			"y":-404,
			"width":340,
			"height":180
		},
		{
			"id":"5bfa23e1c5132e0f",
			"type":"text",
			"text":"**1 - 2 главы**\n\nАри и Корин получили новое задание, сдав старое\n\nИх заданием было - сбор информации, но Ари захочет закончить начатое\n\nПосле облавы Ари снова встречается со связным и рассказывает, что они сделали. Тот принимает инфу и оставляет их ждать.\n\nИм дают задание с убийством капеллана",
			"styleAttributes":{"textAlign":"center"},
			"x":-4436,
			"y":-374,
			"width":300,
			"height":490,
			"color":"6"
		},
		{
			"id":"38aeab1d99a627ed",
			"type":"text",
			"text":"найдут карту с местами убежищ культистов на севере Арда",
			"styleAttributes":{},
			"x":-1470,
			"y":-249,
			"width":320,
			"height":60
		},
		{
			"id":"70fa4d618acce6da",
			"type":"text",
			"text":"после битвы выпьют вина Корина",
			"styleAttributes":{},
			"x":-1450,
			"y":-564,
			"width":260,
			"height":60
		},
		{
			"id":"924a83daee29ea0a",
			"type":"text",
			"text":"найдут информацию о болезни, которую разносит вода (несколько поселений)\n\nруны: вода, болезнь, две деревни",
			"styleAttributes":{},
			"x":-1430,
			"y":-449,
			"width":310,
			"height":150
		},
		{
			"id":"c0333b37194033ec",
			"type":"text",
			"text":"у Ари есть книжка с переводом рун, которую ей сделала Фло",
			"styleAttributes":{},
			"x":-1070,
			"y":-404,
			"width":300,
			"height":60
		},
		{
			"id":"0472a44b6158140b",
			"type":"text",
			"text":"Эльфийская библиотека",
			"styleAttributes":{"textAlign":"center"},
			"x":-3870,
			"y":-344,
			"width":220,
			"height":60,
			"color":"6"
		},
		{
			"id":"d6675e586868e158",
			"type":"text",
			"text":"Ари и Корин возвращаются в город, находят там связного и Ари расказывает ему о находке",
			"styleAttributes":{},
			"x":-3646,
			"y":-104,
			"width":260,
			"height":120
		},
		{
			"id":"ffa58738cba6ff4e",
			"type":"text",
			"text":"Городок",
			"styleAttributes":{"textAlign":"center"},
			"x":-3886,
			"y":-74,
			"width":130,
			"height":60,
			"color":"6"
		},
		{
			"id":"6de6ee96d116f658",
			"type":"text",
			"text":"Связной молча выслушивает, с ухмылкой кивает и закрывает дверь",
			"styleAttributes":{},
			"x":-3290,
			"y":-74,
			"width":260,
			"height":100
		},
		{
			"id":"0127fe72ed77aaad",
			"type":"text",
			"text":"подумает про себя, что лучше бы её магия была такой, а не той, что была дарована ей сфинксами",
			"styleAttributes":{},
			"x":-2540,
			"y":-89,
			"width":260,
			"height":120
		},
		{
			"id":"8a4676b2dbd22859",
			"type":"text",
			"text":"Корина ранят, на что Ари скажет, что не может постоянно за него беспокоиться. Ей нужно думать о выполнении миссии, а не о его сохранности. \nНу и наругает за невнимательность",
			"styleAttributes":{},
			"x":-2310,
			"y":-379,
			"width":320,
			"height":190
		},
		{
			"id":"c0825537eb81a645",
			"type":"text",
			"text":"Будет накладывать ему ткань на рану, вопреки отнекиваниям Корина из-за её нелюбви к прикосновениям",
			"styleAttributes":{},
			"x":-2037,
			"y":-119,
			"width":294,
			"height":120
		},
		{
			"id":"57f2e2d658949737",
			"type":"text",
			"text":"Мысли Ари, что Корин единственный, кто составлял ей компанию последние несколько лет, и заслуживает хотя бы помощи за его терпение",
			"styleAttributes":{},
			"x":-1600,
			"y":-59,
			"width":420,
			"height":120
		},
		{
			"id":"6c26a8b594c7e955",
			"type":"text",
			"text":"Ари расскажет Корину, что связные - маги безмолвной речи (телепаты), они могут общаться с другими такими магами",
			"styleAttributes":{},
			"x":-2836,
			"y":-104,
			"width":260,
			"height":150
		},
		{
			"id":"2f259e82c4e599ab",
			"type":"text",
			"text":"Корин поблагодарит Ари за спасение, пока они ждут",
			"styleAttributes":{},
			"x":-2740,
			"y":66,
			"width":260,
			"height":60
		},
		{
			"id":"28465089e5583a27",
			"type":"text",
			"text":"Через полчаса находит Ари и Корина седлающих лошадей и передаёт записку с новым заданием",
			"styleAttributes":{},
			"x":-2670,
			"y":156,
			"width":260,
			"height":120
		},
		{
			"id":"e31e3eb3098b82eb",
			"type":"text",
			"text":"Корин спросит, все ли связные немые? Ари ответит, что не знает, они очень скрытные",
			"styleAttributes":{},
			"x":-2370,
			"y":166,
			"width":360,
			"height":100
		},
		{
			"id":"e21c304649dc5b1d",
			"type":"text",
			"text":"описание библиотеки и рассказ про эльфов",
			"styleAttributes":{},
			"x":-3010,
			"y":-404,
			"width":260,
			"height":60
		},
		{
			"id":"fc5e17a061ad9f3b",
			"type":"text",
			"text":"мысли про поведение культистов и рассказ про её работу в отряде пять лет назад",
			"styleAttributes":{},
			"x":-3010,
			"y":-314,
			"width":260,
			"height":120
		},
		{
			"id":"ab02acaf283b4fe4",
			"type":"text",
			"text":"диалог про культистов по дороге к убежищу рабита",
			"styleAttributes":{},
			"x":-2870,
			"y":-579,
			"width":260,
			"height":60
		},
		{
			"id":"e1dcd8d020faf277",
			"type":"text",
			"text":"битва с культистами",
			"styleAttributes":{"textAlign":"center"},
			"x":-2610,
			"y":-344,
			"width":200,
			"height":60,
			"color":"6"
		},
		{
			"id":"eef01a9affd7aa27",
			"type":"text",
			"text":"В голове прозвучал голос отца:\n«Мы носим лик наших богов.\nМы исполняем их волю.\nМы – их инструмент, голос и оружие.»",
			"styleAttributes":{},
			"x":-2250,
			"y":-659,
			"width":260,
			"height":220
		},
		{
			"id":"7c11974ac1886765",
			"type":"text",
			"text":"поиск ценной информации",
			"styleAttributes":{"textAlign":"center"},
			"x":-1890,
			"y":-344,
			"width":260,
			"height":60,
			"color":"6"
		},
		{
			"id":"0907cf728c7ec319",
			"type":"text",
			"text":"диалог про вино\n\nАри обещала Корину, что купит ему вино, но отнекивалась, ибо оно невкусное",
			"styleAttributes":{},
			"x":-2870,
			"y":-792,
			"width":260,
			"height":183
		},
		{
			"id":"786ea4a3dc82a1c1",
			"type":"text",
			"text":"**4 - ... главы**\nПоход в клуб Дельца",
			"styleAttributes":{"textAlign":"center"},
			"x":654,
			"y":1136,
			"width":220,
			"height":101,
			"color":"6"
		},
		{
			"id":"9a6a5c10025976c1",
			"type":"text",
			"text":"проникновение в подвал клуба",
			"styleAttributes":{"textAlign":"center"},
			"x":1173,
			"y":1419,
			"width":250,
			"height":60,
			"color":"6"
		},
		{
			"id":"e0fcfb586130a538",
			"type":"text",
			"text":"встреча с Варель",
			"styleAttributes":{"textAlign":"center"},
			"x":1147,
			"y":1254,
			"width":184,
			"height":60,
			"color":"6"
		},
		{
			"id":"9eaf424bf2dd647f",
			"type":"text",
			"text":"беседа в кафе",
			"styleAttributes":{"textAlign":"center"},
			"x":1177,
			"y":1120,
			"width":154,
			"height":50,
			"color":"6"
		},
		{
			"id":"9e67adb20eb8927a",
			"type":"text",
			"text":"Выяснение информации о работе Дельца и его связи с капеланом",
			"styleAttributes":{"textAlign":"center"},
			"x":1702,
			"y":1461,
			"width":250,
			"height":96,
			"color":"6"
		},
		{"id":"a1edb9c4fc00976a","type":"text","text":"диалог с Варель про рабство","x":1565,"y":1359,"width":275,"height":60},
		{
			"id":"42e57098bcd2425a",
			"type":"text",
			"text":"воспоминания Дельца",
			"styleAttributes":{"textAlign":"center"},
			"x":1740,
			"y":1840,
			"width":240,
			"height":60,
			"color":"6"
		},
		{
			"id":"52ffc37483368fab",
			"type":"text",
			"text":"отдаёт конверт капеллану",
			"styleAttributes":{},
			"x":2100,
			"y":1800,
			"width":260,
			"height":60
		},
		{
			"id":"3ba7f2cd7707e93d",
			"type":"text",
			"text":"благодарит за саваж",
			"styleAttributes":{},
			"x":2120,
			"y":1880,
			"width":200,
			"height":60
		},
		{"id":"e27f3785db122183","type":"text","text":"","x":639,"y":1860,"width":250,"height":90},
		{"id":"b883884e63e2e87c","type":"text","text":"Разговор о кораблях:\nДелец намекнёт, что может достать самые редкие товары, Ари выведет его на информацию, что товары он развозит по всему Арду, у него большая сеть","x":2152,"y":1461,"width":438,"height":159},
		{
			"id":"bc2dd1a79b71d7b4",
			"type":"text",
			"text":"капеллан поставлял саваж\nАри предложит свои услуги по предоставлению саважа (типа есть связи)",
			"styleAttributes":{},
			"x":2234,
			"y":1640,
			"width":260,
			"height":120
		},
		{
			"id":"f0c2d08b362b7c9a",
			"type":"text",
			"text":"Покупаешь раба, и он должен окупиться.\nЕсли раб не окупается, - ?",
			"styleAttributes":{},
			"x":2276,
			"y":1120,
			"width":260,
			"height":160
		},
		{"id":"e1e8cfb72c227119","type":"text","text":"варель в отключке","x":1952,"y":1300,"width":197,"height":50},
		{"id":"da6d6c48ad0f8660","type":"text","text":"Разговор о рабах:\nДелец расскажет о системе выгоды\n(Ари подозревает, что капеллан был одним из членов клуба)","x":2234,"y":1334,"width":343,"height":115},
		{
			"id":"151b135a8cfd8c58",
			"type":"text",
			"text":"**1 глава**\nзнакомство с Ари ",
			"styleAttributes":{"textAlign":"center"},
			"x":634,
			"y":-1120,
			"width":260,
			"height":100,
			"color":"6"
		},
		{
			"id":"1549ed6edf6922d5",
			"type":"text",
			"text":"что стоит оставить?",
			"styleAttributes":{"textAlign":"center"},
			"x":-470,
			"y":935,
			"width":260,
			"height":60,
			"color":"5"
		},
		{
			"id":"3dfd43b758703946",
			"type":"text",
			"text":"невнятное начало с культистами",
			"styleAttributes":{},
			"x":-330,
			"y":1115,
			"width":260,
			"height":60
		},
		{
			"id":"d2393b25eece73c4",
			"type":"text",
			"text":"осмотр тела капеллана и его комнат",
			"styleAttributes":{},
			"x":-670,
			"y":1215,
			"width":260,
			"height":60,
			"color":"4"
		},
