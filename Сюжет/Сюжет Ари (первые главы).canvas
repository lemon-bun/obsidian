			"styleAttributes":{},
			"x":-310,
			"y":1355,
			"width":260,
			"height":60
		},
		{
			"id":"9d06f03b08e9a4b3",
			"type":"text",
			"text":"Клуб и рабство",
			"styleAttributes":{},
			"x":-650,
			"y":1395,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"ef7a633421117f87",
			"type":"text",
			"text":"драка в порту",
			"styleAttributes":{},
			"x":-340,
			"y":1595,
			"width":260,
			"height":60
		},
		{
			"id":"2892c5f9a61a19cf",
			"type":"text",
			"text":"чтение памяти",
			"styleAttributes":{},
			"x":-460,
			"y":1495,
			"width":260,
			"height":60
		},
		{
			"id":"a49923715c103cb3",
			"type":"text",
			"text":"нужно показаь характер Ари:\n1. Она доводит дела до конца\n2. Не любит прикосновения\n3. Живёт работой",
			"styleAttributes":{},
			"x":615,
			"y":-1320,
			"width":299,
			"height":160,
			"color":"4"
		},
		{
			"id":"1351e3625fcf9aa6",
