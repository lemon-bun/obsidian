			"height":60
		},
		{
			"id":"d7547acb2f8c65a6",
			"type":"text",
			"text":"Клуб и рабство",
			"styleAttributes":{},
			"x":-1820,
			"y":1404,
			"width":260,
			"height":60
		},
		{
