			"width":260,
			"height":60
		},
		{
			"id":"c0de45078a6f1638",
			"type":"text",
			"text":"что сейчас есть?",
			"styleAttributes":{"textAlign":"center"},
			"x":-1640,
			"y":944,
			"width":260,
			"height":60,
			"color":"2"
		},
		{
			"id":"ddcade68855eb4f6",
			"type":"text",
			"text":"основная работа Ари\nпоказывает её как профессионала",
			"styleAttributes":{},
			"x":-1020,
			"y":1198,
			"width":260,
			"height":95
		},
		{
			"id":"17d7fc667c616c86",
			"type":"text",
			"text":"поднимает тему эльфов за границами Гил-Глаэля",
			"styleAttributes":{},
			"x":-980,
			"y":1395,
			"width":260,
			"height":60
		},
		{
			"id":"86ed1e75d8006ab2",
			"type":"text",
			"text":"\"Шрам\" скитается с книгой, Ари не раз пыталась его поймать, но в итоге он сбежал совсем",
			"styleAttributes":{},
			"x":-820,
			"y":1960,
			"width":300,
			"height":100
		},
		{"id":"2ee20c2c8c361da1","type":"file","file":"Сатис/Корин.md","x":0,"y":38,"width":400,"height":526},
		{
			"id":"637f80a2ed92c4e1",
			"type":"text",
			"text":"Делец\nкапеллан",
			"styleAttributes":{"textAlign":"center"},
			"x":-730,
			"y":2280,
			"width":120,
			"height":80
		},
		{
			"id":"afa6182b9f6492b2",
			"type":"text",
			"text":"эльфы",
			"styleAttributes":{"textAlign":"center"},
			"x":-720,
			"y":2420,
			"width":100,
			"height":60
		},
		{
			"id":"9cf3d61a0e5706bb",
			"type":"text",
			"text":"Делец перехватил их корабль и забрал в рабство\n\nАри приходит к Дельцу и выясняет подробности про его дела с капелланом\n\nКапеллан занимался продажей саважа\nУзнал про книгу",
			"styleAttributes":{},
			"x":-800,
			"y":2580,
			"width":260,
			"height":260
		},
		{
			"id":"01b841c20e8e8543",
			"type":"text",
			"text":"Ари в Ипреиме",
			"styleAttributes":{},
			"x":-520,
			"y":2150,
			"width":180,
			"height":60
		},
		{
			"id":"221b57a88ad2ad55",
			"type":"text",
			"text":"Чел в Ипреиме",
			"styleAttributes":{},
			"x":-1000,
			"y":2150,
			"width":180,
			"height":60
		},
		{
			"id":"65eabdeb5bd02b8c",
			"type":"text",
			"text":"Ари должна снова стать Тенью",
			"styleAttributes":{},
			"x":-340,
			"y":2660,
			"width":260,
			"height":60,
			"color":"5"
		},
		{
			"id":"4792e887a8736b0f",
			"type":"text",
			"text":"челы, что выкрали книгу из под носа Ари\n\nЦель:\n",
			"styleAttributes":{},
			"x":-480,
			"y":2360,
			"width":260,
			"height":220
		}
	],
